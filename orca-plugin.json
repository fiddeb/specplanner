{
  "manifestVersion": 2,
  "id": "specplanner",
  "name": "SpecPlanner",
  "version": "0.5.1",
  "description": "Plan with Codex using OpenSpec documents, revision-aware reviews, and an Excalidraw board.",
  "engines": { "orca": ">=1.4.246" },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "dist/orca-worker.js",
  "capabilities": [{ "kind": "workspace:read" }, { "kind": "storage:own" }],
  "contributes": {
    "panels": [{ "id": "planner", "title": "SpecPlanner", "icon": "book", "entry": "dist/orca-panel.html", "ui": "html" }]
  }
}
