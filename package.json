{
  "name": "specplanner",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "package": "npm run build && tsx scripts/package.ts",
    "verify:package": "npm run package && tsx scripts/verify-package.ts",
    "release:archive": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fission-ai/openspec": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "marked": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid@3": "3.3.18",
    "body-parser": "2.4.0",
    "hono": "4.13.16",
    "@hono/node-server": "2.1.6",
